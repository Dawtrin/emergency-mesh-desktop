<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<!--
    NodeClient.fxml — Giao diện Node Giả Lập (Victim / Relay)
    Design: Cyber Tactical C2 — Deep Navy Slate, Neon accents, Glass borders
    Controller: com.rescue.mesh.ui.controller.NodeClientController

    Layout: VBox vertical
      ├── Header (node ID + status indicator)
      ├── Relay Monitor Dashboard (hiện nếu RELAY mode) — Phase 2
      │   ├── Upstream Status Card
      │   ├── Relayed Packets Card
      │   ├── Load Level Card
      │   └── Heartbeat Card
      ├── SOS Form Card (hiện nếu VICTIM mode)
      │   ├── Sender name, Alert type, Severity
      │   ├── Victim count, Latitude, Longitude (2 dòng riêng biệt)
      │   ├── Message textarea
      │   └── SOS Button + Quick SOS + Heartbeat
      ├── Dispatch Received Card (hiện khi nhận lệnh)
      └── Log Card (TextArea monospace)

    v2.0: Cyber Tactical C2 redesign — Navy Slate palette, neon SOS button, glass borders.
-->

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rescue.mesh.ui.controller.NodeClientController"
      spacing="0"
      style="-fx-background-color: #0B0F19;"
      prefWidth="450" prefHeight="720">

    <!-- ══════ HEADER BAR ══════ -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>

        <!-- Status indicator dot -->
        <Circle fx:id="statusDot" radius="6" styleClass="status-dot-waiting"/>

        <!-- Node ID -->
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblNodeId" text="NODE_A_VICTIM" styleClass="title-label">
                <font><Font size="18"/></font>
            </Label>
            <Label fx:id="lblNodeInfo" text="Port: 8001 → Next: 8002" styleClass="subtitle-label"/>
        </VBox>

        <!-- Server status -->
        <Label fx:id="lblStatus" text="Đang khởi động..." styleClass="subtitle-label"/>
    </HBox>

    <!-- ══════ SCROLLABLE CONTENT ══════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #0B0F19; -fx-background: #0B0F19;">
        <VBox spacing="16" style="-fx-background-color: #0B0F19;">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- ══════ RELAY MONITOR DASHBOARD (Phase 2) ══════ -->
            <!-- Hiện khi chế độ RELAY, chứa thống kê real-time -->
            <VBox fx:id="relayDashboardContainer" spacing="12" visible="false" managed="false">

                <Label text="📡 RELAY MONITOR DASHBOARD" styleClass="section-header"
                       style="-fx-text-fill: #10B981;"/>

                <!-- Row 1: Upstream Status + Relayed Packets -->
                <HBox spacing="12">
                    <VBox spacing="4" styleClass="relay-stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="🔗 UPSTREAM" styleClass="stat-label" style="-fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblRelayUpstreamStatus" text="Connecting..."
                               styleClass="stat-number" style="-fx-text-fill: #10B981; -fx-font-size: 18;"/>
                        <Label fx:id="lblRelayUpstreamDetail" text=""
                               styleClass="subtitle-label" style="-fx-font-size: 10;"/>
                    </VBox>

                    <VBox spacing="4" styleClass="relay-stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="📦 ĐÃ CHUYỂN TIẾP" styleClass="stat-label" style="-fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblRelayPacketsRelayed" text="0"
                               styleClass="stat-number" style="-fx-text-fill: #0EA5E9; -fx-font-size: 24;"/>
                        <Label text="gói tin" styleClass="subtitle-label" style="-fx-font-size: 10;"/>
                    </VBox>
                </HBox>

                <!-- Row 2: Current Load + Heartbeat -->
                <HBox spacing="12">
                    <VBox spacing="4" styleClass="relay-stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="⚡ TẢI HIỆN TẠI" styleClass="stat-label" style="-fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblRelayCurrentLoad" text="0"
                               styleClass="stat-number" style="-fx-text-fill: #F59E0B; -fx-font-size: 24;"/>
                        <ProgressBar fx:id="relayLoadBar" progress="0" prefWidth="140" prefHeight="6"
                                     style="-fx-accent: #F59E0B;"/>
                    </VBox>

                    <VBox spacing="4" styleClass="relay-stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="💓 HEARTBEAT" styleClass="stat-label" style="-fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblRelayHeartbeat" text="—"
                               styleClass="stat-number" style="-fx-text-fill: #10B981; -fx-font-size: 18;"/>
                        <Label fx:id="lblRelayHeartbeatInterval" text="mỗi 3 giây"
                               styleClass="subtitle-label" style="-fx-font-size: 10;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ══════ SOS FORM CARD ══════ -->
            <VBox fx:id="sosFormContainer" spacing="0" styleClass="card">

                <!-- Section header -->
                <Label text="THÔNG TIN SOS" styleClass="section-header"/>

                <!-- Form Fields -->
                <VBox spacing="12">
                    <padding><Insets top="8"/></padding>

                    <!-- Sender Name -->
                    <VBox spacing="4">
                        <Label text="Tên người gửi" styleClass="subtitle-label"/>
                        <TextField fx:id="txtSenderName" promptText="Nhập tên nạn nhân..."
                                   styleClass="text-field"/>
                    </VBox>

                    <!-- Alert Type + Severity (2 columns) -->
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Loại tình huống" styleClass="subtitle-label"/>
                            <ComboBox fx:id="cboAlertType" maxWidth="Infinity"
                                      styleClass="combo-box"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Mức độ" styleClass="subtitle-label"/>
                            <ComboBox fx:id="cboSeverity" maxWidth="Infinity"
                                      styleClass="combo-box"/>
                        </VBox>
                    </HBox>

                    <!-- Victim Count (full width) -->
                    <VBox spacing="4">
                        <Label text="Số nạn nhân" styleClass="subtitle-label"/>
                        <TextField fx:id="txtVictimCount" promptText="1"
                                   styleClass="text-field"/>
                    </VBox>

                    <!-- Phase 2: Latitude + Longitude trên 2 dòng riêng biệt -->
                    <VBox spacing="4">
                        <Label text="Vĩ độ (Latitude)" styleClass="subtitle-label"/>
                        <TextField fx:id="txtLatitude" promptText="15.9738"
                                   styleClass="text-field"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Kinh độ (Longitude)" styleClass="subtitle-label"/>
                        <TextField fx:id="txtLongitude" promptText="108.2515"
                                   styleClass="text-field"/>
                    </VBox>

                    <!-- Message -->
                    <VBox spacing="4">
                        <Label text="Mô tả tình huống" styleClass="subtitle-label"/>
                        <TextArea fx:id="txtMessage" promptText="Mô tả chi tiết tình huống..."
                                  prefRowCount="2" wrapText="true"
                                  styleClass="text-area"/>
                    </VBox>

                    <!-- Buttons -->
                    <VBox spacing="10">
                        <padding><Insets top="6"/></padding>
                        <Button fx:id="btnSendSos" text="🚨  GỬI TÍN HIỆU SOS"
                                maxWidth="Infinity" styleClass="sos-button"
                                onAction="#onSendSos"/>
                        <HBox spacing="10">
                            <Button fx:id="btnQuickSos" text="⚡ SOS Nhanh"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    styleClass="button-secondary"
                                    onAction="#onQuickSos"/>
                            <Button fx:id="btnHeartbeat" text="💓 Heartbeat"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    styleClass="button-secondary"
                                    onAction="#onHeartbeat"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>

            <!-- ══════ DISPATCH RECEIVED CARD (hiện khi nhận lệnh) ══════ -->
            <VBox fx:id="dispatchCard" spacing="8" styleClass="dispatch-received-card" visible="false" managed="false">
                <Label text="📋 LỆNH CHỈ ĐẠO TỪ TRẠM CHỈ HUY" styleClass="section-header"
                       style="-fx-text-fill: #0EA5E9;"/>
                <Label fx:id="lblDispatchContent" wrapText="true"
                       style="-fx-text-fill: #F1F5F9; -fx-font-size: 15;"/>
                <Button fx:id="btnAckDispatch" text="✅ Đã Hiểu Lệnh"
                        maxWidth="Infinity" styleClass="dispatch-button"
                        onAction="#onAcknowledgeDispatch"/>
            </VBox>

            <!-- ══════ LOG CARD ══════ -->
            <VBox spacing="6" styleClass="card" VBox.vgrow="ALWAYS">
                <Label text="SYSTEM LOG" styleClass="section-header"/>
                <TextArea fx:id="txtLog" editable="false" wrapText="true"
                          prefRowCount="10" VBox.vgrow="ALWAYS"
                          styleClass="log-area"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
